# mock is the safe default for local demos and GitHub Pages.
VITE_APP_MODE=mock
# Optional: override Vite's automatic GitHub Pages base-path inference.
# VITE_BASE_PATH=/your-repository/
# Connected mode needs a separately deployed, authenticated backend. Never put
# service_role keys or AI provider secrets in this file or a Vite environment.
# VITE_API_BASE_URL=https://your-approved-api.example
